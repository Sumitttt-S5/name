{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supply-chain-guardian.local/schemas/scan-report.schema.json",
  "title": "Supply Chain Guardian Scan Report",
  "type": "object",
  "required": [
    "schema_version",
    "scan_id",
    "package",
    "scan_status",
    "risk",
    "coverage",
    "stages",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "scan_id": {
      "type": "string"
    },
    "package": {
      "type": "object",
      "required": ["name", "ecosystem"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": ["string", "null"]},
        "ecosystem": {
          "type": "string",
          "enum": ["pypi", "npm"]
        },
        "artifact_hash": {"type": ["string", "null"]},
        "artifact_filename": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "scan_status": {
      "type": "string",
      "enum": ["COMPLETED", "PARTIAL", "FAILED"]
    },
    "risk": {
      "type": "object",
      "required": ["score", "severity", "confidence"],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "severity": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", "UNKNOWN"]
        },
        "confidence": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"]
        },
        "explanation": {"type": "string"}
      },
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "properties": {
        "files_discovered": {"type": "integer", "minimum": 0},
        "files_analyzed": {"type": "integer", "minimum": 0},
        "files_skipped": {"type": "integer", "minimum": 0},
        "limitations": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "stages": {
      "type": "object",
      "properties": {
        "stage_1_name_and_lie_detector": {"$ref": "#/$defs/stage"},
        "stage_2_password_and_gibberish_tracker": {"$ref": "#/$defs/stage"},
        "stage_3_update_hijack_detector": {"$ref": "#/$defs/stage"},
        "stage_4_fake_bait_sandbox": {"$ref": "#/$defs/stage"},
        "stage_5_false_alarm_filter": {"$ref": "#/$defs/stage"},
        "stage_6_ai_reporter": {"$ref": "#/$defs/stage"}
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["COMPLETED", "PARTIAL", "NOT_AVAILABLE", "FAILED"]
        },
        "score": {"type": ["integer", "null"]},
        "summary": {"type": "string"}
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": [
        "finding_id",
        "stage",
        "title",
        "description",
        "severity",
        "confidence",
        "evidence"
      ],
      "properties": {
        "finding_id": {"type": "string"},
        "stage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "rule_id": {"type": "string"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "severity": {
          "type": "string",
          "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "confidence": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"]
        },
        "file": {"type": ["string", "null"]},
        "line": {"type": ["integer", "null"]},
        "evidence": {
          "type": "array",
          "items": {"type": "string"}
        },
        "mitre_techniques": {
          "type": "array",
          "items": {"type": "string"}
        },
        "score_contribution": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
